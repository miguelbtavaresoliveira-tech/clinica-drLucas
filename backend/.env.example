# Ambiente
NODE_ENV=development
PORT=3000

# Banco de dados
DATABASE_URL=postgres://clinica:senha@localhost:5432/clinica
DATABASE_URL_TESTE=postgres://clinica:troque-esta-senha@127.0.0.1:5432/clinica_teste
POSTGRES_SENHA_LOCAL=troque-esta-senha

# Segredos
JWT_ACCESS_SEGREDO=segredo-de-teste-com-32-caracteres!!
JWT_DESAFIO_SEGREDO=outro-segredo-de-teste-com-32-caracteres!!
TOTP_CHAVE_CIFRA_B64=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# SMTP (opcional)
SMTP_HOST=smtp.example.com
SMTP_PORTA=587
SMTP_SEGURO=false
SMTP_USUARIO=usuario
SMTP_SENHA=senha
SMTP_REMETENTE=remetente@example.com

# URLs
URL_REDEFINICAO_SENHA=https://example.com/redefinir

# Proxy
TRUST_PROXY=0

# Política
POLITICA_INATIVIDADE_MIN=10
POLITICA_LIMITE_DIAS_OFFLINE=5
POLITICA_LEITURA_APOS_LIMITE=true
POLITICA_MAX_TENTATIVAS_LOGIN=5
POLITICA_BLOQUEIO_PROGRESSIVO_MIN=1,5,15,60
POLITICA_MAX_DISPOSITIVOS=3
POLITICA_TAMANHO_MINIMO_SENHA=12
POLITICA_VALIDADE_ACCESS_MIN=15
POLITICA_VALIDADE_REFRESH_DIAS=30
POLITICA_JANELA_REAUTENTICACAO_MIN=5
POLITICA_MAX_FALHAS_DESBLOQUEIO_LOCAL=10

# Como gerar segredos:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
